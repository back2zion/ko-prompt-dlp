# Copy to .env and fill in. All variables are prefixed AXFILTER_.
AXFILTER_DATABASE_URL=postgresql+psycopg2://axfilter:change-me@db:5432/axfilter
AXFILTER_DATA_DIR=/data

# API keys per role (generate with: python -c "import secrets;print(secrets.token_urlsafe(24))")
AXFILTER_AGENT_KEY=
AXFILTER_VIEWER_KEY=
AXFILTER_ADMIN_KEY=

# Master key for the local provider (hex, 64 chars). For production use KMS instead.
AXFILTER_DATA_KEY=
# AXFILTER_KEY_PROVIDER=awskms
# AXFILTER_KMS_KEY_ID=alias/axfilter

# Behind the bundled nginx TLS proxy:
AXFILTER_REQUIRE_TLS=1
AXFILTER_TRUSTED_PROXY=1
AXFILTER_CORS_ORIGINS=
AXFILTER_LOG_JSON=1

# Per-client rate limiting + daily quota (0 = unlimited)
# AXFILTER_RATE_PER_SEC=20
# AXFILTER_RATE_PER_DAY=100000

# Data retention (days). Originals are purged after ORIGINAL_DAYS; events kept unless EVENT_DAYS>0.
# AXFILTER_RETENTION_ORIGINAL_DAYS=90
# AXFILTER_RETENTION_EVENT_DAYS=0

# Optional transformer NER model (augments rule-based name/address detection; needs axfilter[ner])
# AXFILTER_NER_MODEL=monologg/koelectra-base-v3-naver-ner
# AXFILTER_NER_THRESHOLD=0.5

# LLM egress gateway (OpenAI-compatible reverse proxy that enforces inspection)
# AXFILTER_GATEWAY_UPSTREAM=https://api.openai.com
# AXFILTER_GATEWAY_UPSTREAM_KEY=

# SIEM forwarding (metadata only; never prompt text/values)
# AXFILTER_SIEM_SINK=udp        # none | file | udp
# AXFILTER_SIEM_FORMAT=cef      # cef | syslog | json
# AXFILTER_SIEM_TARGET=siem.internal:514   # file path, or host:port for udp

# OIDC SSO (bearer tokens accepted in addition to API keys)
# AXFILTER_OIDC_ISSUER=https://idp.example.com
# AXFILTER_OIDC_AUDIENCE=axfilter
# AXFILTER_OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# AXFILTER_OIDC_ROLE_CLAIM=groups
# AXFILTER_OIDC_ROLE_MAP={"sec-admins":"admin","sec-ops":"viewer"}
